[importlinter]
root_package = navbe

[importlinter:contract:1]
name = "domains must not depend on mcp_app or api"
type = layers
layers =
    # cli starts the composition root; main wires api + mcp (frozen serve imports app object)
    navbe.cli
    navbe.main
    navbe.mcp_app | navbe.api
    navbe.domains
    navbe.core
